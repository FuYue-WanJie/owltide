#!/bin/sh
# scripts/secretscan — hard gate against pushing secrets.
#
# Scans the FULL content (commit messages + patches) of every commit in
# the given range (default: upstream..HEAD) and exits non-zero on any
# hit, so a non-zero result can never be "read past" by a human.
#
# Rules (any hit blocks):
#   1. sk- prefixed API keys and other known token prefixes
#      (GitHub ghp_/gho_/github_pat_, AWS AKIA/ASIA, Google AIza/ya29.,
#       GitLab glpat-, Slack xox*, Anthropic sk-ant-, ...)
#   2. PEM private key blocks / Bearer tokens
#   3. high-entropy long strings (>=32 chars, >4.1 bits/char — above
#      the hex ceiling, so git SHAs and hex ids never trip it)
#   4. sha256 match against the locally configured real key — hash
#      comparison only, no plaintext ever lives in this repo
#
# There is NO marker-based skip: a "test"-labeled key would let real
# third-party keys slip through. Legit-looking values that must be
# committed (e.g. documented examples) are allowlisted line by line in
# scripts/secretscan-allow with the sha256 of the value and a reason;
# the file carries no plaintext.
#
# Known limitations (documented, deliberate): a secret below the
# entropy threshold with no known prefix is only caught by rule 4
# (requires the key to be configured locally or pinned below).
#
# Usage:      scripts/secretscan [<git-log-range>]
# Pre-push:   scripts/hooks/pre-push (git config core.hooksPath scripts/hooks)
# Extra pins: sha256 hex lines in scripts/secretscan.hashes (one per line)

set -u

fail() { echo "secretscan: $*" >&2; exit 2; }

command -v git >/dev/null 2>&1 || fail "git not found"
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum not found"

# All args form the git rev-list range (e.g. "HEAD --not --remotes").
# Default: only commits the remotes do not already have — new-branch
# and force pushes are judged on their NEW commits, never on
# historical leaks (pinned leaks block only when re-added).
RANGE="$*"
if [ -z "$RANGE" ]; then
  if UP=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) && [ -n "$UP" ]; then
    RANGE="$UP..HEAD"
  else
    RANGE="HEAD --not --remotes"
  fi
fi
# shellcheck disable=SC2086 — ranges like "sha --not --remotes" are
# meant to be split into separate git arguments.
NCOMMITS=$(git rev-list --count $RANGE 2>/dev/null) || fail "bad range: $RANGE"
if [ "$NCOMMITS" = 0 ]; then
  echo "secretscan: clean (empty range $RANGE)"
  exit 0
fi

TMP=$(mktemp) || fail "mktemp"
trap 'rm -f "$TMP" "$TMP.cand" "$TMP.patch"' EXIT

# Full log+patch of the range; drop Go module hash lines (h1:<base64>)
# which are legitimately high-entropy.
git log -p $RANGE 2>/dev/null | grep -v ' h1:' >"$TMP.patch" || fail "git log -p failed"

HITS=0
# report never echoes the matching content: rule id, sha256 prefix
# (12 hex) and the file:line where the hit sits. A blocked secret must
# not leak through the scanner's own output (CI logs are public).
report() { # $1=rule label, $2=matched value (kept out of output)
  sum=$(printf '%s' "$2" | sha256sum | cut -d' ' -f1)
  loc=""
  [ -n "${CUR_LOC:-}" ] && loc=" at $CUR_LOC"
  echo "secretscan: BLOCK [$1] sha256:$(printf '%s' "$sum" | cut -c1-12)$loc" >&2
  HITS=$((HITS + 1))
}

# ---- Allowlist: sha256 -> reason, explicit only.
ALLOW=""
ALLOW_FILE="$(dirname "$0")/secretscan-allow"
if [ -f "$ALLOW_FILE" ]; then
  ALLOW=$(grep -E '^[0-9a-f]{64}' "$ALLOW_FILE" | cut -d' ' -f1 || true)
fi

# ---- Rule 4 prep: hashes of the real configured key and pinned keys.
REAL_SHA=""
if [ -n "${OWLTIDE_API_KEY:-}" ]; then
  REAL_SHA=$(printf '%s' "$OWLTIDE_API_KEY" | sha256sum | cut -d' ' -f1)
fi
PINNED=""
if [ -f "$(dirname "$0")/secretscan.hashes" ]; then
  PINNED=$(grep -E '^[0-9a-f]{64}$' "$(dirname "$0")/secretscan.hashes" || true)
fi

sha256_of() { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }

# check_hash compares the candidate AND its alphanumeric sub-runs
# against the real/pinned key hashes (candidates may carry prefixes
# like "nkey=" glued to the secret).
# hash_hit echoes a label when the candidate (as-is, its alnum
# sub-runs, or an embedded sk- token) matches the real/pinned hashes.
hash_hit() {
  # Key-shaped parts only: whole candidate, embedded sk- token, or
  # alphanumeric runs >= 16 chars. Short fragments are never hashed
  # (a short-fragment hash would be brute-forceable).
  for part in "$1" $(printf '%s' "$1" | grep -oE 'sk-[A-Za-z0-9_-]{16,}' || true) $(printf '%s' "$1" | tr -c 'A-Za-z0-9_' '\n' | awk 'length($0) >= 16'); do
    [ -n "$part" ] || continue
    c=$(sha256_of "$part")
    if [ -n "$REAL_SHA" ] && [ "$c" = "$REAL_SHA" ]; then
      echo "locally configured OWLTIDE_API_KEY|$part"
      return 0
    fi
    if printf '%s\n' "$PINNED" | grep -qxF "$c"; then
      echo "pinned revoked-key sha256|$part"
      return 0
    fi
  done
  return 1
}

check_hash() {
  HIT=$(hash_hit "$1") || return 1
  LBL=${HIT%%|*}
  PART=${HIT#*|}
  if [ "$marker" = "-" ]; then
    echo "secretscan: note: revoked key ($LBL) appears only as a diff removal (allowed, being deleted)" >&2
  else
    report "rule 4: matches sha256 of $LBL" "$PART"
  fi
  return 0
}

is_allowed() { # candidate -> nonzero exit when its sha256 is allowlisted
  c=$(sha256_of "$1")
  printf '%s\n' "$ALLOW" | grep -qxF "$c"
}

# ---- Candidates: contiguous alnum/base64-ish runs, tagged with the
# current file, patch line number, and diff marker ("-" removal,
# "+" addition, " " context). The patch is pre-annotated: each
# "diff --git" line emits an @@FILE marker.
awk '
  /^diff --git / {
    fn = $0
    sub(/^diff --git a\//, "", fn)
    sub(/ b\/.*$/, "", fn)
    next
  }
  {
    line = $0
    marker = " "
    if (substr(line, 1, 1) == "-" && substr(line, 1, 2) != "---") marker = "-"
    else if (substr(line, 1, 1) == "+" && substr(line, 1, 2) != "+++") marker = "+"
    s = line
    # mawk lacks regex intervals; match greedily and filter by length.
    while (match(s, /[A-Za-z0-9_+/=-]+/)) {
      w = substr(s, RSTART, RLENGTH)
      if (length(w) >= 16) print fn "|" NR "|" marker "|" w
      s = substr(s, RSTART + RLENGTH)
    }
  }
' "$TMP.patch" | awk -F'|' '
  { if (!($4 in seen)) { order[++n] = $4; seen[$4] = $1 "|" $2 "|" $3 }
    else if (seen[$4] ~ /\|-$/ || seen[$4] ~ /\|-\|/) { } # keep first non-"-" if any
    if (index(seen[$4], "|-|") == 0 && $3 != "-") seen[$4] = $1 "|" $2 "|" $3 }
  END { for (i = 1; i <= n; i++) print seen[order[i]] "|" order[i] }
' >"$TMP.cand" || true

while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  hfile=${entry%%|*}; rest=${entry#*|}
  hline=${rest%%|*}; rest=${rest#*|}
  marker=${rest%%|*}
  cand=${rest#*|}
  [ -n "$cand" ] || continue
  CUR_LOC="$hfile:~patch-line $hline"
  # Rule 4 first: real key matches even when disguised as a fake.
  if check_hash "$cand"; then
    continue
  fi
  # Explicit allowlist (sha256 only), then nothing else passes.
  if is_allowed "$cand"; then continue; fi
  # A candidate that only appears on diff removal lines is being
  # deleted by this very commit — removing a secret must stay allowed.
  if [ "$marker" = "-" ]; then
    echo "secretscan: note: secret-like string appears only as a diff removal (allowed, being deleted)" >&2
    continue
  fi
  # Rule 1: known token prefixes. Candidates containing "/" are
  # prose/rules-table text (e.g. "sk-/Bearer/ghp_"), not tokens.
  case "$cand" in
    */*) ;;
    sk-* | sk-ant-* | ghp_* | gho_* | ghu_* | ghs_* | ghr_* | github_pat_* | \
    AKIA* | ASIA* | AIza* | glpat-* | gsk_* | xoxb-* | xoxa-* | xoxp-* | xoxr-* | xoxs-* | ya29.*)
      report "rule 1: known token prefix" "$cand"
      continue
      ;;
  esac
  # Rule 3: high-entropy long strings. Hex maxes out at 4.0 b/c, so
  # git SHAs never trip; URL/module-path-shaped strings (with "/")
  # need a higher bar to avoid import-path false positives.
  len=${#cand}
  if [ "$len" -ge 32 ]; then
    ent=$(printf '%s' "$cand" | awk '{
      n = length($0); delete cnt
      for (i = 1; i <= n; i++) cnt[substr($0, i, 1)]++
      e = 0
      for (c in cnt) { p = cnt[c] / n; e -= p * log(p) / log(2) }
      printf "%.2f", e
    }')
    case "$cand" in
      */*) threshold=4.5 ;;
      *) threshold=4.3 ;;
    esac
    if [ "$(awk -v e="$ent" -v t="$threshold" 'BEGIN { print (e > t) ? 1 : 0 }')" = 1 ]; then
      report "rule 3: high-entropy string (${len} chars, ${ent} bits/char)" "$cand"
      continue
    fi
  fi
done <"$TMP.cand"

# ---- Rule 2: PEM blocks and Bearer tokens (line-based).
if grep -nE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' "$TMP.patch" >/dev/null; then
  report "rule 2: PEM private key block" "-----BEGIN ... PRIVATE KEY-----"
fi
grep -nEo 'Bearer [A-Za-z0-9._=-]{20,}' "$TMP.patch" | while IFS= read -r line; do
  tok=${line#*:Bearer }
  if ! is_allowed "$tok"; then
    report "rule 2: Bearer token" "$tok"
  fi
done

if [ "$HITS" -gt 0 ]; then
  echo "secretscan: $HITS hit(s) in range $RANGE — push refused" >&2
  exit 1
fi
echo "secretscan: clean ($RANGE)"
exit 0
