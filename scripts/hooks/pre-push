#!/bin/sh
# pre-push hook: refuse any push whose commits contain secrets.
# Install once per clone: git config core.hooksPath scripts/hooks
#
# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
set -u

# The scanner lives next to this hook (same scripts/ tree), resolved
# from $0 so the hook works from any clone it is configured into.
SCAN=$(cd "$(dirname "$0")" && pwd)/../secretscan
[ -x "$SCAN" ] || exit 0

z40=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue # deletion push
  if [ "$remote_sha" = "$z40" ]; then
    # New branch: scan only commits the remotes do not have, so a
    # historical leak below the merge-base cannot fail unrelated
    # new-branch pushes (pinned leaks block only when re-added).
    "$SCAN" "$local_sha" --not --remotes || rc=1
  else
    "$SCAN" "$remote_sha..$local_sha" || rc=1
  fi
done
exit $rc
